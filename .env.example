# copy to .env (git-ignored). Used by the app (npm run dev) and docker compose.
# Start ../docker-dependencies first (MongoDB).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# must match USER_SERVICE_DB / _DB_USER / _DB_PASSWORD in ../docker-dependencies/.env
MONGO_DATABASE=user_service
MONGO_APP_USERNAME=user_service_app
MONGO_APP_PASSWORD=local_user_service_password

# used when the app runs on the host (docker compose points the container at mongodb:27017 itself)
MONGODB_URI=mongodb://user_service_app:local_user_service_password@127.0.0.1:27017/user_service
